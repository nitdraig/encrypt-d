---
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section id="download" class="section download">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t("download.title")}</h2>
      <p class="section-subtitle">{t("download.subtitle")}</p>
    </div>
    <div class="download-content">
      <div class="download-options">
        <div class="option-card primary">
          <div class="option-badge">Recommended</div>
          <h3 class="option-title">{t("download.options.executable.title")}</h3>
          <p class="option-description">
            {t("download.options.executable.description")}
          </p>
          <p class="option-size">{t("download.options.executable.size")}</p>
          <a href="#" class="btn btn-download">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            {t("download.options.executable.button")}
          </a>
        </div>
        <div class="option-card">
          <h3 class="option-title">{t("download.options.source.title")}</h3>
          <p class="option-description">
            {t("download.options.source.description")}
          </p>
          <a
            href="https://github.com/yourusername/encrypt-d"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path>
            </svg>
            {t("download.options.source.button")}
          </a>
        </div>
      </div>
      <div class="requirements">
        <h3 class="requirements-title">{t("download.requirements.title")}</h3>
        <ul class="requirements-list">
          {
            Array.from({ length: 3 }, (_, i) => (
              <li class="requirement-item">
                <svg
                  class="check-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{t(`download.requirements.items.${i}`)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .download {
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(139, 92, 246, 0.05) 100%
    );
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
  }

  .section-title {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }

  .download-content {
    display: grid;
    gap: 3rem;
  }

  .download-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .option-card {
    background: var(--color-dark-light);
    border: 1px solid rgba(59, 130, 246, 0.1);
    border-radius: 1rem;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    transition: all 0.3s ease;
  }

  .option-card:hover {
    transform: translateY(-5px);
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .option-card.primary {
    border-color: rgba(59, 130, 246, 0.3);
    background: linear-gradient(
      135deg,
      var(--color-dark-light) 0%,
      rgba(59, 130, 246, 0.05) 100%
    );
  }

  .option-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--gradient-primary);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .option-title {
    font-size: 1.75rem;
    color: var(--color-text);
  }

  .option-description {
    color: var(--color-text-muted);
    flex: 1;
  }

  .option-size {
    color: var(--color-primary);
    font-weight: 600;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .btn-download {
    background: var(--gradient-primary);
    color: white;
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);
  }

  .btn-download:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 35px rgba(59, 130, 246, 0.4);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .btn-outline:hover {
    background: var(--color-dark);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .requirements {
    background: var(--color-dark-light);
    border: 1px solid rgba(59, 130, 246, 0.1);
    border-radius: 1rem;
    padding: 2rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .requirements-title {
    font-size: 1.5rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .requirements-list {
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .requirement-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
  }

  .check-icon {
    color: var(--color-success);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }

    .download-options {
      grid-template-columns: 1fr;
    }
  }
</style>
