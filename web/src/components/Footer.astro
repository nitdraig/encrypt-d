---
import { Shield } from "@lucide/astro";

interface Props {
  t: (key: string) => string;
  lang: string;
}

const { t, lang } = Astro.props;
---

<footer class="border-t border-border/40 bg-card/50">
  <div class="container mx-auto px-4 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-2 animate-fade-up">
        <a href={lang === "en" ? "/" : "/es"} class="mb-4 flex items-center gap-2 transition-all hover:scale-105">
          <Shield class="h-6 w-6 text-primary animate-glow" />
          <span class="font-mono text-xl font-bold">Encrypt-D</span>
        </a>
        <p class="text-sm text-muted-foreground leading-relaxed">
          {t("footer.description")}
        </p>
      </div>

      <div class="animate-fade-up" style="animation-delay: 0.1s; animation-fill-mode: both;">
        <h3 class="mb-4 font-semibold">{t("nav.features")}</h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li>
            <a href="#features" class="transition-all hover:text-foreground hover:translate-x-1 inline-block">
              {t("nav.features")}
            </a>
          </li>
          <li>
            <a href="#security" class="transition-all hover:text-foreground hover:translate-x-1 inline-block">
              {t("nav.security")}
            </a>
          </li>
          <li>
            <a href="#download" class="transition-all hover:text-foreground hover:translate-x-1 inline-block">
              {t("nav.download")}
            </a>
          </li>
        </ul>
      </div>

      <div class="animate-fade-up" style="animation-delay: 0.2s; animation-fill-mode: both;">
        <h3 class="mb-4 font-semibold">{t("footer.links.documentation")}</h3>
        <ul class="space-y-2 text-sm text-muted-foreground">
          <li>
            <a href={t("nav.docs")} class="transition-all hover:text-foreground hover:translate-x-1 inline-block">
              {t("footer.links.documentation")}
            </a>
          </li>
          <li>
            <a href="https://github.com/nitdraig/encrypt-d" target="_blank" rel="noopener noreferrer" class="transition-all hover:text-foreground hover:translate-x-1 inline-block">
              {t("nav.github")}
            </a>
          </li>
          <li>
            <a href={t("footer.links.license")} class="transition-all hover:text-foreground hover:translate-x-1 inline-block">
              {t("footer.links.license")}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-border/40 pt-8 text-center text-sm text-muted-foreground animate-fade-in" style="animation-delay: 0.3s; animation-fill-mode: both;">
      <p>{t("footer.copyright")}</p>
    </div>
  </div>
</footer>
