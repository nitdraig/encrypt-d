---
import { Download } from "@lucide/astro";

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section class="container mx-auto px-4 pt-32 pb-20">
  <div class="mx-auto max-w-4xl text-center">
    <div class="mb-6 inline-block animate-fade-down rounded-full border border-primary/20 bg-primary/10 px-4 py-1.5">
      <span class="font-mono text-sm text-primary">{t("hero.badge")}</span>
    </div>

    <h1 class="mb-6 animate-fade-up font-sans text-5xl font-bold leading-tight tracking-tight text-balance md:text-7xl" style="animation-delay: 0.1s; animation-fill-mode: both;">
      {t("hero.title")}
    </h1>

    <p class="mb-10 animate-fade-up text-lg text-muted-foreground text-pretty md:text-xl" style="animation-delay: 0.2s; animation-fill-mode: both;">
      {t("hero.description")}
    </p>

    <div class="flex flex-col items-center justify-center gap-4 animate-fade-up sm:flex-row" style="animation-delay: 0.3s; animation-fill-mode: both;">
      <a 
        href="https://mega.nz/file/x5lj1IrD#pGFBxU1ZArlzQ9bDj0rOf5MWGyh12oYOc6n-59m-tAs" 
        download
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90 hover:scale-105 hover:shadow-lg hover:shadow-primary/50"
      >
        <span class="absolute inset-0 h-full w-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></span>
        <Download class="h-5 w-5 animate-bounce-subtle" />
        {t("hero.cta.download")}
      </a>
      <a 
        href="#features" 
        class="inline-flex items-center justify-center gap-2 rounded-md border border-border bg-transparent px-6 py-3 text-sm font-medium transition-all hover:bg-secondary hover:scale-105 hover:border-primary/50"
      >
        {t("hero.cta.learnMore")}
      </a>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-sm text-muted-foreground animate-fade-in" style="animation-delay: 0.4s; animation-fill-mode: both;">
      <div class="flex items-center gap-2">
        <div class="h-2 w-2 rounded-full bg-primary animate-glow" />
        <span>{t("hero.cta.version")}</span>
      </div>
    </div>
  </div>
</section>

