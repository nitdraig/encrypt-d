---
import { Shield, CircleCheck } from "@lucide/astro";

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<section id="security" class="container mx-auto px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="animate-slide-in-right">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-1.5">
          <Shield class="h-4 w-4 text-primary" />
          <span class="font-mono text-sm text-primary">{t("security.title")}</span>
        </div>

        <h2 class="mb-6 text-4xl font-bold tracking-tight md:text-5xl text-balance">
          {t("security.subtitle")}
        </h2>

        <p class="mb-8 text-lg text-muted-foreground leading-relaxed">
          {t("features.items.encryption.description")}
        </p>
        <div class="grid gap-3">
          {Array.from({ length: 6 }, (_, i) => (
            <div class="flex items-center gap-3 animate-fade-in" style={`animation-delay: ${i * 0.1}s; animation-fill-mode: both;`}>
              <CircleCheck class="h-5 w-5 flex-shrink-0 text-primary transition-transform hover:scale-110" />
              <span class="text-foreground">{t(`security.features.${i}`)}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-lg border border-border/50 bg-card p-8 animate-scale-in" style="animation-delay: 0.2s; animation-fill-mode: both;">
        <div class="space-y-6">
          <div class="rounded-lg border border-primary/20 bg-primary/5 p-6 transition-all hover:scale-105 hover:border-primary/40">
            <div class="mb-2 font-mono text-sm text-primary">{t("security.specs.encryption.description")}</div>
            <div class="text-2xl font-bold">{t("security.specs.encryption.title")}</div>
          </div>

          <div class="rounded-lg border border-border/50 bg-secondary p-6 transition-all hover:scale-105 hover:border-primary/30">
            <div class="mb-2 font-mono text-sm text-muted-foreground">{t("security.specs.hashing.description")}</div>
            <div class="text-2xl font-bold">{t("security.specs.hashing.title")}</div>
          </div>

          <div class="rounded-lg border border-border/50 bg-secondary p-6 transition-all hover:scale-105 hover:border-primary/30">
            <div class="mb-2 font-mono text-sm text-muted-foreground">{t("security.specs.protection.description")}</div>
            <div class="text-2xl font-bold">{t("security.specs.protection.title")}</div>
          </div>

          <div class="rounded-lg border border-border/50 bg-secondary p-6 transition-all hover:scale-105 hover:border-primary/30">
            <div class="mb-2 font-mono text-sm text-muted-foreground">{t("security.specs.privacy.description")}</div>
            <div class="text-2xl font-bold">{t("security.specs.privacy.title")}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
