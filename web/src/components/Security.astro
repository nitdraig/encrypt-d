---
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const specs = ["encryption", "hashing", "protection", "privacy"];
---

<section id="security" class="section security">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t("security.title")}</h2>
      <p class="section-subtitle">{t("security.subtitle")}</p>
    </div>
    <div class="security-content">
      <div class="security-specs">
        {
          specs.map((spec) => (
            <div class="spec-card">
              <h3 class="spec-title">{t(`security.specs.${spec}.title`)}</h3>
              <p class="spec-description">
                {t(`security.specs.${spec}.description`)}
              </p>
            </div>
          ))
        }
      </div>
      <div class="security-features">
        <h3 class="features-title">🛡️ Security Features</h3>
        <ul class="features-list">
          {
            Array.from({ length: 6 }, (_, i) => (
              <li class="feature-item">
                <svg
                  class="check-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{t(`security.features.${i}`)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .security {
    background: var(--color-dark);
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 4rem;
  }

  .section-title {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }

  .security-content {
    display: grid;
    gap: 3rem;
  }

  .security-specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .spec-card {
    background: linear-gradient(
      135deg,
      var(--color-dark-light) 0%,
      rgba(59, 130, 246, 0.05) 100%
    );
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .spec-card:hover {
    transform: translateY(-5px);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 10px 30px rgba(59, 130, 246, 0.2);
  }

  .spec-title {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .spec-description {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .security-features {
    background: var(--color-dark-light);
    border: 1px solid rgba(59, 130, 246, 0.1);
    border-radius: 1rem;
    padding: 2.5rem;
  }

  .features-title {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .features-list {
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .check-icon {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }

    .security-specs {
      grid-template-columns: 1fr;
    }
  }
</style>
